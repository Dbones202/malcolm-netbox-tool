# ==============================================================================
# Unified Malcolm / NetBox Environment Configuration Template
# ==============================================================================
# Shared connection and rate-limiting options
NETBOX_VERIFY_SSL=false
NETBOX_PACE_MS=75
NETBOX_TIMEOUT=45

# Localhost URL used when running directly on the Malcolm VM host (--localhost)
NETBOX_LOCAL_URL=https://127.0.0.1/netbox

# ------------------------------------------------------------------------------
# Team Delta NetBox Instance
# ------------------------------------------------------------------------------
# Remote URL used by instructor laptop/host (e.g. https://<delta-vm-ip>/netbox):
DELTA_NETBOX_URL=https://192.168.1.50/netbox
# API Token for Team Delta NetBox:
DELTA_NETBOX_TOKEN=your_delta_api_token_here

# ------------------------------------------------------------------------------
# Team Omega NetBox Instance
# ------------------------------------------------------------------------------
# Remote URL used by instructor laptop/host (e.g. https://<omega-vm-ip>/netbox):
OMEGA_NETBOX_URL=https://192.168.1.60/netbox
# API Token for Team Omega NetBox:
OMEGA_NETBOX_TOKEN=your_omega_api_token_here

# ------------------------------------------------------------------------------
# Default / Standalone NetBox Instance (Fallback)
# ------------------------------------------------------------------------------
# Used when no --team or --localhost flag is provided
NETBOX_URL=https://127.0.0.1/netbox
NETBOX_TOKEN=your_api_token_here

# Classroom / Challenge Defaults
EXCEL_FILE=Netbox_Worksheet.xlsx
DEFAULT_INTERFACE=eth0
DEFAULT_PREFIX_LENGTH=24
REPLACE_SPACES_WITH_UNDERSCORES=False
